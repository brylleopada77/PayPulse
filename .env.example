# Copy this file to .env and adjust if needed:  cp .env.example .env
PORT=3000
DATABASE_URL=postgres://paypulse:paypulse@localhost:5432/paypulse
JWT_SECRET=change-me-in-real-life
JWT_EXPIRES_IN=1h
WEBHOOK_SECRET=dev-webhook-secret
# Dev/QA only: QA Sandbox panel + /api/qa endpoints. Never enable in production.
QA_SANDBOX=true
# Master secret for virtual card encryption / CVV derivation. Set a long random value in real deployments.
# CARD_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Dev/QA/demo only: the mock "Add money" checkout (no real payment). Never enable in production.
MOCK_PAYMENTS=true
# Comma-separated emails that get the ADMIN role (Add money, QA tools). Example:
# ADMIN_EMAILS=you@example.com
