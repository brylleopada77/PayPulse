{
  "name": "paypulse",
  "version": "1.0.0",
  "description": "PayPulse - a simple e-wallet backend (Express + PostgreSQL) built for QA practice",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:check": "tsx tests/helpers/db-check.ts",
    "test:api": "playwright test",
    "test:report": "playwright show-report",
    "test:concurrency": "k6 run tests/load/concurrency-test.js && node scripts/assert-ledger.js",
    "db:assert-ledger": "node scripts/assert-ledger.js",
    "db:remediate-overdrafts": "node scripts/remediate-overdrafts.js",
    "db:seed": "node scripts/seed-qa.js",
    "eod:reconcile": "node scripts/reconcile-eod.js",
    "pesonet:worker": "node scripts/pesonet-worker.js",
    "admin:set": "node scripts/set-role.js",
    "theme:dark": "node scripts/build-dark-theme.js",
    "postman:build": "node scripts/build-postman.js",
    "postman:test": "newman run postman/PayPulse.postman_collection.json -e postman/PayPulse-local.postman_environment.json --reporters cli,junit --reporter-junit-export reports/newman-junit.xml"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "newman": "^6.2.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
